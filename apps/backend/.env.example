# Hashport backend — copy to .env and fill in. Never commit real secrets.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# ── Storage ───────────────────────────────────────────────────────────────────
# Postgres: users, wallets, transaction history
DATABASE_URL=postgres://hashport:hashport@localhost:5432/hashport
# Redis: conversation state for multi-step chat flows (e.g. confirm-before-send)
REDIS_URL=redis://localhost:6379

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; must match the token entered in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=change-me
# Meta app secret, used to verify X-Hub-Signature-256 on incoming webhooks
WHATSAPP_APP_SECRET=

# ── Stellar ───────────────────────────────────────────────────────────────────
# testnet | mainnet
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Deployed hashport-account Soroban contract ID (starts with C...)
HASHPORT_CONTRACT_ID=
# Relayer / fee-payer account secret key (starts with S...) — NEVER commit
SIGNER_SECRET_KEY=
# 32-byte hex key used to encrypt custodial user keypairs at rest
WALLET_ENCRYPTION_KEY=
