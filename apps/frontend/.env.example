# Hashport frontend — copy to .env.local and fill in.
# All values here are public (NEXT_PUBLIC_*) and shipped to the browser.

# Base URL of the Hashport backend API (apps/backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Stellar network the app points at: testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed hashport-account Soroban contract ID (starts with C...)
NEXT_PUBLIC_HASHPORT_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# WhatsApp number of the Hashport bot, used for the wa.me deep link (digits only)
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=15550000000
